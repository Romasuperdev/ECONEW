# ===== MODÈLE DE CONFIGURATION PRODUCTION =====
# Copier vers .env sur le serveur, puis : php artisan key:generate --force
# NE JAMAIS committer le .env réel.

APP_NAME="Gestion Financiere Scolaire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://api.votre-domaine.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Journalisation : niveau réduit en production
LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de données : utiliser un compte à privilèges limités (PAS 'sa')
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=dbmasterbacou
DB_USERNAME=econew_app
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Origine du front en production (utilisée par CORS)
FRONTEND_URL=https://app.votre-domaine.com
# Origines supplémentaires éventuelles, séparées par des virgules
CORS_EXTRA_ORIGINS=

# Messagerie (renseigner un vrai SMTP en production)
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Structure academique ECONOMAT ---
ECONOMAT_CODE_ETAB=
ECONOMAT_ANNEE=
ECONOMAT_CODE_SOCIETE=

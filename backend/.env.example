APP_NAME="Gestion Financiere Scolaire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Abidjan
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=dbmasterbacou
DB_USERNAME=sa
DB_PASSWORD=
# Connexion locale SQL Server (souvent nécessaire) :
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@econew.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Structure academique ECONOMAT (T_CYCLE / T_NIVEAU / T_CLASSE) ---
ECONOMAT_CODE_ETAB=
ECONOMAT_ANNEE=
ECONOMAT_CODE_SOCIETE=
